# 이 파일을 .streamlit/secrets.toml 로 복사한 뒤 실제 값을 채워넣으세요.
# secrets.toml은 절대 git에 커밋하지 마세요 (.gitignore에 추가 권장).

[snowflake]
account = "your_account_identifier"   # 예: xy12345.ap-southeast-2
user = "your_username"
warehouse = "COMPUTE_WH"
database = "HARBOUR_CAFE"
agent_schema = "ANALYTIC"
# Key-pair auth (recommended for deployment) — paste the unencrypted PKCS8
# private key PEM here instead of pointing at a rsa_key.p8 file on disk.
private_key = """
-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"""

[anthropic]
api_key = "sk-ant-..."

[smtp]
# Automated supplier price-alert emails. "provider" picks connection presets
# from lib/smtp/providers.py — swap it (and credentials) to change providers
# without touching any code. Use "custom" + host/port/use_tls for anything
# not in the preset list.
provider = "mailtrap"        # mailtrap | gmail | office365 | ses | custom
user = "your_mailtrap_user"
password = "your_mailtrap_password"
from_addr = "copilot@harbourstreetcafe.example"
# host = "smtp.example.com"  # only needed when provider = "custom"
# port = 587
# use_tls = true
